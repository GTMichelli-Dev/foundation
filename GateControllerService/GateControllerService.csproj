<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      Fallback for local builds. The release workflow passes -p:Version from the
      git tag, so a published artifact reports the release it shipped in. Leave
      AssemblyVersion, FileVersion and InformationalVersion unset: the SDK
      derives all three from Version, and setting them here would pin them past
      anything the tag says.
    -->
    <Version>1.20.1</Version>
    <Product>Gate Controller Service</Product>
    <Description>Drives a gate relay and light from the Raspberry Pi's GPIO header when a ticket completes, releasing on weight drop or timeout.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.*" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.EventLog" Version="10.0.*" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <PackageReference Include="System.Device.Gpio" Version="3.2.0" />
  </ItemGroup>

</Project>
