@{
    ViewData["Title"] = "Card Setup";
    var recycleCards = (bool)(ViewBag.RecycleCards ?? false);
    var useCardReader = (bool)(ViewBag.UseCardReader ?? false);
    var useRetainedTare = (bool)(ViewBag.UseRetainedTare ?? false);
    var canManageCards = (bool)(ViewBag.CanManageCards ?? false);
}

@section Styles {
<style>
    /* Two layouts. On a phone - a touch device small on whichever side is
       short, the same test as the Home page's driver tile - this is the loader
       operator's page, used one-handed outdoors next to a running truck: one
       column, targets big enough to hit without looking, and the save bar
       pinned within thumb reach. Anything else - a desktop, a laptop, a
       tablet - gets an ordinary page with the fields side by side. */
    .card-setup .cs-panel {
        background: var(--bw-surface);
        border: 1px solid var(--bw-border, rgba(128,128,128,0.3));
        border-radius: 8px;
        padding: 12px 16px;
        margin-bottom: 12px;
    }

    .card-setup label.cs-label {
        display: block;
        font-size: 0.875rem;
        font-weight: 600;
        margin-bottom: 2px;
        color: var(--bw-text);
    }
    .card-setup .cs-required { color: #dc3545; font-weight: 700; }

    .cs-number-row { display: flex; gap: 8px; max-width: 580px; }
    .cs-number-row .form-control { flex: 1; }
    #cardNumberInput { font-size: 1.25rem; font-weight: 700; letter-spacing: 1px; }

    .cs-head-btn { padding: 0.45rem 1.1rem; font-size: 1rem; font-weight: 600; }

    /* A required field left blank is outlined until it is answered: the kiosk
       would stop the driver to ask for it. */
    .card-setup .cs-req-missing .form-control,
    .card-setup .cs-req-missing .form-select {
        border-color: #dc3545;
        background-color: rgba(220, 53, 69, 0.06);
        box-shadow: inset 3px 0 0 #dc3545;
    }

    .card-setup .cs-desc-field { max-width: 580px; }

    /* The card's fields side by side, as many columns as the width allows. */
    #csFields {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 12px 16px;
    }

    .cs-status {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        font-size: 1rem;
    }
    .cs-badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 999px;
        font-weight: 700;
        font-size: 0.9rem;
    }
    .cs-badge-issued { background: #198754; color: #fff; }
    .cs-badge-free { background: #6c757d; color: #fff; }
    .cs-badge-open { background: #fd7e14; color: #000; }
    .cs-badge-disabled { background: #dc3545; color: #fff; }

    .cs-actionbar { display: flex; justify-content: flex-end; gap: 8px; margin-top: 4px; }

    .cs-toast {
        position: fixed;
        top: 70px; right: 16px;
        width: 420px; max-width: calc(100% - 32px);
        z-index: 1040;
        padding: 12px 16px;
        border-radius: 8px;
        font-weight: 600;
        display: none;
    }
    .cs-toast-ok { background: #d1e7dd; color: #0f5132; border: 1px solid #badbcc; }
    .cs-toast-err { background: #f8d7da; color: #842029; border: 1px solid #f5c2c7; }

    .cs-confirm .cs-missing-list {
        margin: 10px 0 0;
        padding-left: 20px;
        font-weight: 700;
    }

    /* ----- Phone ----- */
    @@media (hover: none) and (pointer: coarse) and (max-width: 500px),
           (hover: none) and (pointer: coarse) and (max-height: 500px) {
        .card-setup { max-width: 560px; margin: 0 auto; padding-bottom: 96px; }
        .card-setup .cs-title { font-size: 1.5rem; }
        .card-setup .cs-panel { border-radius: 12px; padding: 16px; margin-bottom: 14px; }
        .card-setup label.cs-label { font-size: 0.95rem; margin-bottom: 4px; }

        /* 1.15rem keeps iOS from zooming the viewport on focus, and 54px is a
           comfortable glove-width target. */
        .card-setup .form-control,
        .card-setup .form-select { font-size: 1.15rem; min-height: 54px; border-radius: 10px; }

        .cs-number-row { flex-direction: column; max-width: none; }
        #cardNumberInput { font-size: 1.6rem; text-align: center; min-height: 64px; }
        #btnRecall { min-height: 54px; font-size: 1.1rem; font-weight: 700; order: 1; }
        #btnSearch { order: 2; min-height: 48px; font-size: 1.05rem; }
        .cs-head-btn { padding: 0.25rem 0.5rem; font-size: 0.875rem; font-weight: 400; }

        #csFields { display: block; }
        .card-setup .cs-field { margin-bottom: 14px; }
        .card-setup .cs-field:last-child { margin-bottom: 0; }

        /* Save bar pinned to the bottom so it never scrolls out of thumb reach. */
        .cs-actionbar {
            position: fixed;
            left: 0; right: 0; bottom: 0;
            margin: 0;
            background: var(--bw-surface);
            border-top: 2px solid var(--bw-border, rgba(128,128,128,0.3));
            padding: 10px 12px calc(10px + env(safe-area-inset-bottom));
            gap: 10px;
            z-index: 1030;
        }
        .cs-actionbar .btn { flex: 1; min-height: 58px; font-size: 1.15rem; font-weight: 700; border-radius: 10px; }
        .cs-actionbar .btn-release { flex: 0 0 38%; }

        .cs-toast { left: 12px; right: 12px; top: 12px; width: auto; max-width: none; padding: 14px 16px; border-radius: 10px; }

        /* Confirmation dialog — same glove-width targets as the rest of the page. */
        .cs-confirm { border-radius: 14px; }
        .cs-confirm .modal-body { font-size: 1.05rem; }
        .cs-confirm .modal-footer .btn {
            flex: 1;
            min-height: 54px;
            font-size: 1.1rem;
            font-weight: 700;
            border-radius: 10px;
        }
    }
</style>
}

<div class="card-setup">
    <div class="d-flex justify-content-between align-items-center mb-2 gap-2">
        <h3 class="mb-0 cs-title">Card Setup</h3>
        @* Both are enrollment pages (Manager / Admin), so a loader operator is
           not shown buttons that would only answer "access denied". *@
        @if (canManageCards)
        {
            <div class="d-flex gap-2">
                <a href="/Card/Bulk" class="btn btn-outline-primary cs-head-btn">Bulk Update</a>
                <a href="/Card" class="btn btn-outline-secondary cs-head-btn">Cards</a>
            </div>
        }
    </div>
    <p class="text-muted small mb-2">
        A card carries a load's details so nobody has to enter them at the scale.
        Set them here and issue the card: the driver presents it at a card reader
        or keys its number in at the kiosk, and the details fill themselves in.
    </p>

    @if (!useCardReader)
    {
        <div class="alert alert-warning py-2">
            Cards are turned off. They can still be set up here, but a kiosk will not
            accept one, presented or keyed in, until <strong>Use Cards</strong> is on
            in Setup &rarr; System &rarr; Cards.
        </div>
    }

    <div id="csToast" class="cs-toast"></div>

    <!-- STEP 1: identify the card -->
    <div class="cs-panel">
        <label class="cs-label" for="cardNumberInput">Card Number</label>
        <div class="cs-number-row">
            <input type="text" class="form-control" id="cardNumberInput"
                   inputmode="numeric" autocomplete="off" autocapitalize="off" spellcheck="false"
                   placeholder="Enter card number" />
            <button type="button" class="btn btn-outline-secondary" id="btnSearch"
                    title="Find a card by its number, description or anything it carries">Search</button>
            <button type="button" class="btn btn-primary" id="btnRecall">Recall Card</button>
        </div>
        <div class="form-text mt-2">
            Enter the full number on the card. Cards are registered on the
            <a href="/Card">Cards</a> page before they can be issued.
        </div>
    </div>

    <!-- STEP 2: card state + fields (revealed after a successful recall) -->
    <div id="cardBody" style="display:none;">
        <div class="cs-panel">
            <div class="cs-status">
                <span id="csStatusBadge" class="cs-badge cs-badge-free">Available</span>
                <strong>Card <span id="csCardNumber"></span></strong>
                <span id="csCardDescription" class="text-muted"></span>
                @if (canManageCards)
                {
                    <button type="button" class="btn btn-outline-secondary btn-sm ms-auto" id="btnChangeNumber">Change Number</button>
                }
            </div>
            <div id="csLastUsed" class="form-text mt-1"></div>
            <div id="csOpenTicketWarning" class="alert alert-warning py-2 mt-2 mb-0" style="display:none;"></div>
        </div>

        <div class="cs-panel">
            <div class="cs-field cs-desc-field">
                <label class="cs-label" for="csDescription">Description</label>
                <input type="text" class="form-control" id="csDescription" maxlength="100" autocomplete="off" />
                @* Shown when the Truck ID is required (Setup → Kiosk Prompts), so
                   every card carries one to take the description from. *@
                <div id="csDescFromTruckRow" style="display:none;">
                    <div class="form-check mt-1">
                        <input class="form-check-input" type="checkbox" id="csDescFromTruck" />
                        <label class="form-check-label" for="csDescFromTruck">Use the Truck ID as the description</label>
                    </div>
                    <div class="form-text mt-0">Ticked, the description follows the truck. Type your own to override it.</div>
                </div>
            </div>
        </div>

        <div class="cs-panel">
            <div id="csReqNote" class="form-text mt-0 mb-2" style="display:none;">
                <span class="cs-required">*</span> Required — the kiosk stops the driver to ask for any left blank.
            </div>
            <div id="csFields"><!-- built from /api/cards/fields --></div>
        </div>

        <div class="cs-panel">
            <div class="cs-field">
                <label class="cs-label" for="csRecycleMode">After this load</label>
                <select class="form-select" id="csRecycleMode">
                    <option value="Default">Site default (@(recycleCards ? "recycle card" : "deactivate card"))</option>
                    <option value="Recycle">Recycle — driver keeps the card and can run another load</option>
                    <option value="Deactivate">Deactivate — driver returns the card to me</option>
                </select>
                <div class="form-text">
                    A recycled card keeps everything set here and works again straight away.
                    A deactivated card stops working once the truck is off the scale.
                </div>
            </div>
        </div>

        <div class="cs-actionbar">
            <button type="button" class="btn btn-outline-danger btn-release" id="btnRelease">Deactivate</button>
            <button type="button" class="btn btn-success" id="btnIssue">Save &amp; Issue</button>
        </div>
    </div>
</div>

<!-- Card search: find a card without its number to hand. -->
<div class="modal fade" id="csSearchModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content cs-confirm">
            <div class="modal-header">
                <h5 class="modal-title">Find a Card</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="search" class="form-control mb-2" id="csSearchInput" autocomplete="off"
                       placeholder="Number, description, customer, carrier, truck…" />
                <div id="csSearchResults" class="list-group"></div>
            </div>
        </div>
    </div>
</div>

<!-- Confirmation dialog. Replaces window.confirm so the prompt is readable on a
     phone and matches the rest of the app — the native dialog renders at the top
     of the screen in the browser's own styling, out of thumb reach. -->
<div class="modal fade" id="csConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content cs-confirm">
            <div class="modal-header">
                <h5 class="modal-title" id="csConfirmTitle">Confirm</h5>
            </div>
            <div class="modal-body" id="csConfirmBody"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" id="csConfirmCancel" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="csConfirmOk">OK</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    'use strict';

    var USE_RETAINED_TARE = @(useRetainedTare ? "true" : "false");

    var fields = [];        // descriptors from the server
    var currentCard = null; // the recalled card
    var truckCache = {};    // carrier -> [truckId]

    var $number = document.getElementById('cardNumberInput');
    var $body = document.getElementById('cardBody');
    var $fields = document.getElementById('csFields');
    var $toast = document.getElementById('csToast');
    var $desc = document.getElementById('csDescription');
    var $descFromTruck = document.getElementById('csDescFromTruck');

    // ===== SETUP =====

    fetch('/api/cards/fields')
        .then(function (r) { return r.json(); })
        .then(function (data) { fields = data.fields || []; })
        .catch(function () { toast('err', 'Could not load field list. Reload the page.'); });

    document.getElementById('btnRecall').addEventListener('click', recall);
    document.getElementById('btnIssue').addEventListener('click', issue);
    document.getElementById('btnRelease').addEventListener('click', release);
    document.getElementById('btnSearch').addEventListener('click', openSearch);
    var $changeNumber = document.getElementById('btnChangeNumber');
    if ($changeNumber) $changeNumber.addEventListener('click', changeNumber);

    // Required fields re-check as they are answered.
    $fields.addEventListener('input', markRequired);
    $fields.addEventListener('change', markRequired);

    // Enter on the number box recalls, so a keyboard wedge or a phone keypad
    // "go" key works without hunting for the button.
    $number.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') { e.preventDefault(); recall(); }
    });

    // ===== RECALL =====

    function recall() {
        var number = ($number.value || '').trim();
        if (!number) { toast('err', 'Enter the card number.'); $number.focus(); return; }

        setBusy(true);
        fetch('/api/cards/lookup?cardNumber=' + encodeURIComponent(number))
            .then(readJson)
            .then(function (data) {
                if (!data.found) {
                    $body.style.display = 'none';
                    currentCard = null;
                    toast('err', 'Card ' + number + ' is not registered. Add it on the Cards page first.');
                    return;
                }
                currentCard = data.card;
                renderCard();
                toast('ok', 'Card ' + currentCard.cardNumber + ' recalled.');
            })
            .catch(function (err) { toast('err', err.message || 'Lookup failed.'); })
            .finally(function () { setBusy(false); });
    }

    function renderCard() {
        $body.style.display = '';
        document.getElementById('csCardNumber').textContent = currentCard.cardNumber;
        document.getElementById('csCardDescription').textContent = currentCard.description || '';
        document.getElementById('csRecycleMode').value = currentCard.recycleMode || 'Default';

        var badge = document.getElementById('csStatusBadge');
        var warn = document.getElementById('csOpenTicketWarning');
        warn.style.display = 'none';

        if (!currentCard.enabled) {
            badge.className = 'cs-badge cs-badge-disabled';
            badge.textContent = 'Disabled';
        } else if (currentCard.openTicket) {
            badge.className = 'cs-badge cs-badge-open';
            badge.textContent = 'On ticket #' + currentCard.openTicket;
            warn.style.display = '';
            warn.textContent = 'This card is on open ticket #' + currentCard.openTicket +
                '. It has to weigh out before it can be issued again.';
        } else if (currentCard.issued) {
            badge.className = 'cs-badge cs-badge-issued';
            badge.textContent = 'Issued';
        } else {
            badge.className = 'cs-badge cs-badge-free';
            badge.textContent = 'Available';
        }

        var lastUsed = document.getElementById('csLastUsed');
        if (currentCard.lastTicket) {
            lastUsed.textContent = 'Last load: ticket #' + currentCard.lastTicket +
                (currentCard.lastUsedAt ? ' — ' + new Date(currentCard.lastUsedAt).toLocaleString() : '');
        } else {
            lastUsed.textContent = 'No loads on this card yet.';
        }

        renderFields(currentCard.values || {});
        renderDescription(currentCard.values || {});
    }

    // ===== DESCRIPTION =====
    // With the Truck ID required the description can follow it: ticked, it is
    // set from the truck, now and whenever the truck changes. Typing a
    // description of your own unticks the box, so an override is never
    // written over, and a card recalled with a description that isn't its
    // truck starts unticked for the same reason.

    function truckRequired() {
        return fields.some(function (f) { return f.key === 'truck' && f.required; });
    }

    function renderDescription(values) {
        var desc = currentCard.description || '';
        var show = truckRequired();
        document.getElementById('csDescFromTruckRow').style.display = show ? '' : 'none';
        $descFromTruck.checked = show && (!desc || desc === (values.truck || ''));
        $desc.value = $descFromTruck.checked && values.truck ? values.truck : desc;
    }

    function followTruck() {
        if (!$descFromTruck.checked) return;
        var truck = document.getElementById('fld_truck');
        if (truck && truck.value) $desc.value = truck.value;
    }

    $desc.addEventListener('input', function () { $descFromTruck.checked = false; });
    $descFromTruck.addEventListener('change', followTruck);

    // ===== FIELDS =====

    function renderFields(values) {
        $fields.innerHTML = '';
        fields.forEach(function (f) {
            $fields.appendChild(buildField(f, values[f.key]));
        });
        // Trucks depend on the carrier chosen above them.
        var carrier = values.carrier;
        if (carrier) loadTrucks(carrier, values.truck);
        refreshCascades();
        document.getElementById('csReqNote').style.display =
            fields.some(function (f) { return f.required; }) ? '' : 'none';
        markRequired();
    }

    function buildField(f, value) {
        var wrap = document.createElement('div');
        wrap.className = 'cs-field';
        if (f.required) wrap.classList.add('cs-req');

        var label = document.createElement('label');
        label.className = 'cs-label';
        label.setAttribute('for', 'fld_' + f.key);
        label.textContent = f.label;
        if (f.required) {
            var req = document.createElement('span');
            req.className = 'cs-required';
            req.textContent = ' *';
            label.appendChild(req);
        }
        wrap.appendChild(label);

        var input;
        if (f.type === 'number') {
            input = document.createElement('input');
            input.type = 'number';
            input.className = 'form-control';
            input.inputMode = f.integer ? 'numeric' : 'decimal';
            if (f.minValue !== null && f.minValue !== undefined) input.min = f.minValue;
            if (f.maxValue !== null && f.maxValue !== undefined) input.max = f.maxValue;
            if (f.integer) input.step = '1';
            else if (f.precision) input.step = Math.pow(10, -f.precision).toFixed(f.precision);
            input.value = value || '';
        } else if (f.type === 'text') {
            input = document.createElement('input');
            input.type = 'text';
            input.className = 'form-control';
            input.value = value || '';
        } else {
            // list / truck
            input = document.createElement('select');
            input.className = 'form-select';
            fillOptions(input, f.type === 'truck' ? [] : (f.items || []), value);
        }

        input.id = 'fld_' + f.key;
        input.setAttribute('data-key', f.key);
        wrap.appendChild(input);

        if (f.key === 'carrier') {
            input.addEventListener('change', function () {
                loadTrucks(this.value, null);
            });
        }
        if (f.key === 'truck') input.addEventListener('change', followTruck);
        // A parent field's answer filters its sub-fields' choices.
        if (fields.some(function (x) { return x.parentKey === f.key; })) {
            input.addEventListener('change', refreshCascades);
        }

        if (f.key === 'truck' && USE_RETAINED_TARE) {
            var hint = document.createElement('div');
            hint.className = 'form-text';
            hint.textContent = 'Retained Tare is on: with a carrier and truck set, a stored tare finishes the load in one weighment.';
            wrap.appendChild(hint);
        }

        return wrap;
    }

    function fillOptions(select, items, selected) {
        select.innerHTML = '';
        var blank = document.createElement('option');
        blank.value = '';
        blank.textContent = '— not set —';
        select.appendChild(blank);

        (items || []).forEach(function (item) {
            var opt = document.createElement('option');
            opt.value = item;
            opt.textContent = item;
            select.appendChild(opt);
        });

        // A value the list no longer offers (renamed master data, or a choice
        // now limited to another location) shows blank, so saving the card
        // clears it rather than carrying an out-of-date choice to the kiosk.
        select.value = selected || '';
        if (select.value !== (selected || '')) select.value = '';
        markRequired();
    }

    function loadTrucks(carrier, selected) {
        var select = document.getElementById('fld_truck');
        if (!select) return;

        var keep = selected !== undefined && selected !== null ? selected : select.value;
        if (!carrier) { fillOptions(select, [], keep); return; }

        if (truckCache[carrier]) { fillOptions(select, truckCache[carrier], keep); return; }

        fetch('/api/cards/trucks?carrier=' + encodeURIComponent(carrier))
            .then(readJson)
            .then(function (trucks) {
                truckCache[carrier] = trucks || [];
                fillOptions(select, truckCache[carrier], keep);
            })
            .catch(function () { fillOptions(select, [], keep); });
    }

    /// Re-filter every cascading sub-field against its parent's current answer.
    function refreshCascades() {
        fields.forEach(function (f) {
            if (!f.parentKey || !f.valueMap) return;
            var select = document.getElementById('fld_' + f.key);
            var parent = document.getElementById('fld_' + f.parentKey);
            if (!select || !parent) return;

            var items = parent.value ? (f.valueMap[parent.value] || []) : (f.items || []);
            fillOptions(select, items, select.value);
        });
    }

    function collectValues() {
        var values = {};
        fields.forEach(function (f) {
            var el = document.getElementById('fld_' + f.key);
            values[f.key] = el ? (el.value || '') : '';
        });
        return values;
    }

    // ===== ISSUE / DEACTIVATE =====

    function issue() {
        if (!currentCard) return;

        var values = collectValues();
        var missing = fields.filter(function (f) {
            return f.required && !values[f.key];
        });

        var ask = missing.length === 0
            ? Promise.resolve(true)
            : confirmDialog({
                title: 'Fields Not Set',
                // A list beats a comma-joined sentence here: the operator is
                // deciding whether to walk back and fill them in.
                html: 'These are not set on this card:' +
                      '<ul class="cs-missing-list">' +
                      missing.map(function (f) { return '<li>' + escHtml(f.label) + '</li>'; }).join('') +
                      '</ul>' +
                      '<p class="mt-3 mb-0">The driver will be asked for them at the kiosk.</p>',
                okText: 'Issue Anyway',
                okClass: 'btn-warning'
            });

        ask.then(function (proceed) {
            if (!proceed) return;

            setBusy(true);
            fetch('/api/cards/' + currentCard.id + '/issue', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    values: values,
                    recycleMode: document.getElementById('csRecycleMode').value,
                    description: $desc.value.trim()
                })
            })
                .then(readJson)
                .then(function (data) {
                    currentCard = data.card;
                    renderCard();
                    toast('ok', 'Card ' + currentCard.cardNumber + ' issued. Hand it to the driver.');
                })
                .catch(function (err) { toast('err', err.message || 'Could not issue the card.'); })
                .finally(function () { setBusy(false); });
        });
    }

    function release() {
        if (!currentCard) return;

        confirmDialog({
            title: 'Deactivate Card',
            html: 'Deactivate card <strong>' + escHtml(currentCard.cardNumber) + '</strong>?' +
                  '<p class="mt-2 mb-0">It will stop working at the kiosk until it is issued again.</p>',
            okText: 'Deactivate',
            okClass: 'btn-danger'
        }).then(function (proceed) {
            if (!proceed) return;
            doRelease();
        });
    }

    function doRelease() {
        setBusy(true);
        fetch('/api/cards/' + currentCard.id + '/release', { method: 'POST' })
            .then(readJson)
            .then(function (data) {
                currentCard = data.card;
                renderCard();
                toast('ok', 'Card ' + currentCard.cardNumber + ' deactivated.');
            })
            .catch(function (err) { toast('err', err.message || 'Could not deactivate the card.'); })
            .finally(function () { setBusy(false); });
    }

    // ===== REQUIRED FIELDS =====

    /// Outline every required field still blank: the kiosk would stop the
    /// driver to ask for it.
    function markRequired() {
        $fields.querySelectorAll('.cs-req').forEach(function (wrap) {
            var input = wrap.querySelector('input, select');
            wrap.classList.toggle('cs-req-missing', !!input && !(input.value || '').trim());
        });
    }

    // ===== SEARCH =====

    var searchModal = null;
    var searchTimer = null;
    var searchSeq = 0;

    function openSearch() {
        var el = document.getElementById('csSearchModal');
        var input = document.getElementById('csSearchInput');
        if (!searchModal) {
            searchModal = new bootstrap.Modal(el);
            el.addEventListener('shown.bs.modal', function () { input.focus(); });
            input.addEventListener('input', function () {
                clearTimeout(searchTimer);
                searchTimer = setTimeout(runSearch, 250);
            });
        }
        input.value = ($number.value || '').trim();
        runSearch();
        searchModal.show();
    }

    function runSearch() {
        var q = document.getElementById('csSearchInput').value.trim();
        var $results = document.getElementById('csSearchResults');
        var seq = ++searchSeq;
        fetch('/api/cards/search?q=' + encodeURIComponent(q))
            .then(readJson)
            .then(function (list) {
                if (seq !== searchSeq) return; // a later keystroke already asked again
                if (!list.length) {
                    $results.innerHTML = '<div class="text-muted p-2">No cards match.</div>';
                    return;
                }
                $results.innerHTML = list.map(function (c) {
                    var carries = fields.map(function (f) { return (c.values || {})[f.key]; }).filter(Boolean);
                    var line = [c.description].concat(carries).filter(Boolean).join(' · ');
                    return '<button type="button" class="list-group-item list-group-item-action" data-number="' + escHtml(c.cardNumber) + '">' +
                        '<div class="d-flex align-items-center gap-2 flex-wrap">' +
                            '<strong>Card ' + escHtml(c.cardNumber) + '</strong>' + statusBadgeHtml(c) +
                        '</div>' +
                        (line ? '<div class="small text-muted">' + escHtml(line) + '</div>' : '') +
                        '</button>';
                }).join('');
                $results.querySelectorAll('[data-number]').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        $number.value = this.getAttribute('data-number');
                        searchModal.hide();
                        recall();
                    });
                });
            })
            .catch(function (err) {
                if (seq !== searchSeq) return;
                $results.innerHTML = '<div class="text-danger p-2">' + escHtml(err.message || 'Search failed.') + '</div>';
            });
    }

    function statusBadgeHtml(c) {
        if (!c.enabled) return '<span class="cs-badge cs-badge-disabled">Disabled</span>';
        if (c.openTicket) return '<span class="cs-badge cs-badge-open">On ticket #' + escHtml(c.openTicket) + '</span>';
        if (c.issued) return '<span class="cs-badge cs-badge-issued">Issued</span>';
        return '<span class="cs-badge cs-badge-free">Available</span>';
    }

    // ===== CHANGE NUMBER =====

    /// Give the recalled card a new number. The card keeps its values and
    /// history; the form's unsaved edits are left as they are.
    function changeNumber() {
        if (!currentCard) return;

        var ask = confirmDialog({
            title: 'Change Card Number',
            html: '<label class="cs-label" for="csNewNumber">New number for card ' + escHtml(currentCard.cardNumber) + '</label>' +
                  '<input type="text" class="form-control" id="csNewNumber" inputmode="numeric" autocomplete="off" value="' +
                  escHtml(currentCard.cardNumber) + '" />' +
                  '<p class="form-text mt-2 mb-0">Card numbers are 1 to 99999. The card keeps everything set on it.</p>',
            okText: 'Change Number',
            okClass: 'btn-primary'
        });

        var input = document.getElementById('csNewNumber');
        input.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') { e.preventDefault(); document.getElementById('csConfirmOk').click(); }
        });
        setTimeout(function () { input.focus(); input.select(); }, 350);

        ask.then(function (proceed) {
            if (!proceed) return;
            var number = (input.value || '').trim();
            if (!number || number === currentCard.cardNumber) return;

            setBusy(true);
            fetch('/api/cardadmin/' + currentCard.id, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    cardNumber: number,
                    description: currentCard.description || '',
                    enabled: currentCard.enabled,
                    recycleMode: currentCard.recycleMode || 'Default'
                })
            })
                .then(readJson)
                .then(function (card) {
                    var old = currentCard.cardNumber;
                    currentCard.cardNumber = card.cardNumber;
                    $number.value = card.cardNumber;
                    document.getElementById('csCardNumber').textContent = card.cardNumber;
                    toast('ok', 'Card ' + old + ' is now card ' + card.cardNumber + '.');
                })
                .catch(function (err) { toast('err', err.message || 'Could not change the number.'); })
                .finally(function () { setBusy(false); });
        });
    }

    // ===== CONFIRM DIALOG =====

    var confirmModal = null;
    var confirmResolve = null;

    /// Bootstrap-modal stand-in for window.confirm. Resolves true on OK and
    /// false on Cancel, backdrop click, or Esc — so dismissing the dialog any
    /// way at all is treated as "no", the same as the native prompt.
    function confirmDialog(opts) {
        var el = document.getElementById('csConfirmModal');

        document.getElementById('csConfirmTitle').textContent = opts.title || 'Confirm';
        document.getElementById('csConfirmBody').innerHTML = opts.html || '';

        var ok = document.getElementById('csConfirmOk');
        ok.textContent = opts.okText || 'OK';
        ok.className = 'btn ' + (opts.okClass || 'btn-success');

        if (!confirmModal) {
            confirmModal = new bootstrap.Modal(el);

            ok.addEventListener('click', function () {
                settle(true);
                confirmModal.hide();
            });
            // Fires for Cancel, the backdrop, and Esc alike. Runs after the OK
            // handler has already settled, and settle() ignores the second call.
            el.addEventListener('hidden.bs.modal', function () { settle(false); });
        }

        return new Promise(function (resolve) {
            confirmResolve = resolve;
            confirmModal.show();
        });
    }

    function settle(answer) {
        if (!confirmResolve) return;
        var resolve = confirmResolve;
        confirmResolve = null;
        resolve(answer);
    }

    // ===== HELPERS =====

    function escHtml(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
    }

    function readJson(response) {
        return response.json().catch(function () { return {}; }).then(function (body) {
            if (!response.ok) throw new Error(body.message || ('Request failed (' + response.status + ')'));
            return body;
        });
    }

    function setBusy(busy) {
        ['btnRecall', 'btnIssue', 'btnRelease'].forEach(function (id) {
            var el = document.getElementById(id);
            if (el) el.disabled = busy;
        });
    }

    var toastTimer = null;
    function toast(kind, message) {
        $toast.className = 'cs-toast ' + (kind === 'ok' ? 'cs-toast-ok' : 'cs-toast-err');
        $toast.textContent = message;
        $toast.style.display = 'block';
        clearTimeout(toastTimer);
        toastTimer = setTimeout(function () { $toast.style.display = 'none'; }, kind === 'ok' ? 3500 : 7000);
    }

    $number.focus();
})();
</script>
}
