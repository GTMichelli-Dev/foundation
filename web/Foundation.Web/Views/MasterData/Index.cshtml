@{
    ViewData["Title"] = "Tables";
    var kioskCount = (int)ViewBag.KioskCount;
    var showKiosk = kioskCount > 0;
    var useQuickBooks = (bool)ViewBag.UseQuickBooks;
    var useRetainedTare = (bool)(ViewBag.UseRetainedTare ?? false);
    var customFieldLists = ViewBag.CustomFieldLists as List<Foundation.Web.Models.CustomField>
        ?? new List<Foundation.Web.Models.CustomField>();
    var setup = (Foundation.Web.Models.AppSetup)ViewBag.Setup;
    // Standard-field tabs follow the field's visibility (Setup → Fields):
    // no point managing master data for a field the forms never show.
    var standardTabs = new List<(string Tab, string Grid, string Label)>();
    if (!setup.HideCustomer) standardTabs.Add(("customersTab", "customersGrid", "Customers"));
    if (!setup.HideCarrier) standardTabs.Add(("carriersTab", "carriersGrid", "Carriers"));
    if (!setup.HideTruckId) standardTabs.Add(("trucksTab", "trucksGrid", "Trucks"));
    if (!setup.HideLocation) standardTabs.Add(("locationsTab", "locationsGrid", "Locations"));
    if (!setup.HideDestination) standardTabs.Add(("destinationsTab", "destinationsGrid", "Destinations"));
    if (setup.UseBinInventory) standardTabs.Add(("binsTab", "binsGrid", "Bins"));
    if (!setup.HideCommodity) standardTabs.Add(("commoditiesTab", "commoditiesGrid", "Commodities"));
}

<style>
    /* Customers grid Carrier column — keep "Carrier" badge and "Add to
       Carriers" button at the same width so the column reads cleanly. */
    .btn-carrier-cell {
        width: 140px;
        text-align: center;
    }

    /* Style the grids' Delete link (and the truck grids' Clear Tare) as
       Bootstrap buttons. Delete is outline-danger; Clear Tare is amber so
       it doesn't read as a second Delete. */
    .dx-datagrid .dx-link-delete,
    .dx-datagrid .btn-clear-tare {
        display: inline-block;
        padding: 0.2rem 0.55rem;
        font-size: 0.8125rem;
        line-height: 1.4;
        border-radius: 0.3rem;
        border: 1px solid transparent;
        text-decoration: none !important;
        font-weight: 500;
        transition: color .12s, background-color .12s, border-color .12s;
    }
    .dx-datagrid .dx-link-delete {
        color: #dc3545;
        background: transparent;
        border-color: #dc3545;
    }
    .dx-datagrid .dx-link-delete:hover {
        color: #fff;
        background: #dc3545;
        border-color: #dc3545;
    }
    .dx-datagrid .btn-clear-tare {
        color: #b58105;
        border-color: #b58105;
        background: transparent;
    }
    .dx-datagrid .btn-clear-tare:hover {
        color: #fff;
        background: #b58105;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h3 class="mb-0">Tables</h3>
    <div>
        <span id="qbSyncStatus" class="me-2 text-muted small"></span>
        @if (useQuickBooks)
        {
            <button id="btnQBSync" class="btn btn-success btn-sm" onclick="triggerQBSync()" style="display:none;">
                <i class="fa fa-download"></i> Sync from QuickBooks
            </button>
        }
    </div>
</div>

@if (useQuickBooks)
{
    <div id="qbStatusBanner" class="alert alert-warning py-1 mb-2 d-flex align-items-center" role="alert">
        <div><i class="fa fa-spinner fa-spin"></i> Checking QuickBooks connection...</div>
    </div>
}

<ul class="nav nav-tabs" id="masterDataTabs" role="tablist">
    @{ var isFirstTab = true; }
    @foreach (var (tab, _, label) in standardTabs)
    {
        <li class="nav-item">
            <button class="nav-link @(isFirstTab ? "active" : "")" data-bs-toggle="tab" data-bs-target="#@tab">@label</button>
        </li>
        isFirstTab = false;
    }
    @foreach (var cf in customFieldLists)
    {
        <li class="nav-item">
            <button class="nav-link @(isFirstTab ? "active" : "")" data-bs-toggle="tab" data-bs-target="#cfListTab_@cf.Id">@cf.Name</button>
        </li>
        isFirstTab = false;
    }
</ul>

<div class="tab-content mt-3">
    @{ var isFirstPane = true; }
    @foreach (var (tab, grid, _) in standardTabs)
    {
        <div class="tab-pane fade @(isFirstPane ? "show active" : "")" id="@tab">
            <div id="@grid"></div>
        </div>
        isFirstPane = false;
    }
    @foreach (var cf in customFieldLists)
    {
        <div class="tab-pane fade @(isFirstPane ? "show active" : "")" id="cfListTab_@cf.Id">
            @if (cf.ParentField == null)
            {
                <p class="small text-muted mb-2">
                    Dropdown choices for the <strong>@cf.Name</strong> custom field
                    (Setup &rarr; Fields). Drag rows to reorder. Values already saved
                    on tickets are kept even if removed here.
                </p>
                <div id="cfListGrid_@cf.Id" class="cf-list-grid" data-field-id="@cf.Id" style="max-width: 480px;"></div>
            }
            else
            {
                var cfNames = ViewBag.CustomFieldNames as Dictionary<int, string> ?? new Dictionary<int, string>();
                var parentLabel = cf.ParentField.StartsWith("cf_")
                    && int.TryParse(cf.ParentField[3..], out var pid) && cfNames.TryGetValue(pid, out var pname)
                        ? pname
                        : cf.ParentField;
                <p class="small text-muted mb-2">
                    <strong>@cf.Name</strong> is a sub-field of <strong>@parentLabel</strong>
                    (Setup &rarr; Fields): its dropdown choices are grouped under each
                    @parentLabel value. Pick a @parentLabel, then manage its choices below.
                    Drag rows to reorder. Values already saved on tickets are kept even
                    if removed here.
                </p>
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="small fw-bold">@parentLabel:</span>
                    <div id="cfParentPicker_@cf.Id" style="width: 300px;"></div>
                </div>
                <div id="cfListGrid_@cf.Id" class="cf-dep-list-grid" data-field-id="@cf.Id"
                     data-parent-field="@cf.ParentField" style="max-width: 480px; display: none;"></div>
                <p id="cfDepPickHint_@cf.Id" class="small text-muted">Pick a @parentLabel above to edit its @cf.Name choices.</p>
            }
        </div>
        isFirstPane = false;
    }
    @if (standardTabs.Count == 0 && customFieldLists.Count == 0)
    {
        <p class="text-muted">All standard fields are hidden and no dropdown custom fields are defined — nothing to edit here. Manage field visibility on <a href="/Setup">Setup &rarr; Fields</a>.</p>
    }
</div>

<!-- Unsaved-changes confirmation when leaving the page -->
<div class="modal fade" id="mdLeaveConfirmModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title">Unsaved changes</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                You have unsaved changes. Save them before continuing?
            </div>
            <div class="modal-footer py-1">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Stay</button>
                <button type="button" class="btn btn-outline-danger btn-sm" id="mdLeaveDiscardBtn">Discard &amp; Continue</button>
                <button type="button" class="btn btn-primary btn-sm" id="mdLeaveSaveBtn">Save &amp; Continue</button>
            </div>
        </div>
    </div>
</div>

<!-- QB-sync confirmation when there are unsaved batch edits in any grid -->
<div class="modal fade" id="mdSyncConfirmModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title">Unsaved changes</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                You have unsaved edits in one or more grids. Syncing from QuickBooks
                will refresh the grids and discard those staged edits. Save them
                first if you want to keep them.
            </div>
            <div class="modal-footer py-1">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger btn-sm" id="mdSyncDiscardBtn">Discard &amp; Sync</button>
                <button type="button" class="btn btn-primary btn-sm" id="mdSyncSaveBtn">Save &amp; Sync</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Confirmation for the truck grid's Clear-Tare button.
    function promptClearTare(rowData, gridComponent) {
        bwConfirm('Clear retained tare for ' + rowData.truckId + '? The next weigh-in for this truck will run a normal two-pass cycle to capture a fresh tare.',
            'Clear Retained Tare', { okText: 'Clear', danger: true }).then(function (ok) {
            if (!ok || rowData.id == null) return;
            $.ajax({
                url: '/api/retainedtares/' + rowData.id + '/clear',
                method: 'POST'
            }).done(function () {
                if (gridComponent && gridComponent.refresh) gridComponent.refresh();
            });
        });
    }

    // Refresh the parent Carriers grid after a truck add / remove so the
    // "# Trucks" column stays accurate without a manual page reload.
    function refreshCarriersGrid() {
        var grid = $('#carriersGrid').dxDataGrid('instance');
        if (grid) grid.refresh();
    }

    // Refresh the Trucks tab after a truck or carrier edit elsewhere on the
    // page, so it never shows a stale list.
    function refreshTrucksGrid() {
        var grid = $('#trucksGrid').dxDataGrid('instance');
        if (grid) grid.refresh();
    }

    // Toolbar item that toggles a grid between paged (default 20/page) and
    // unpaged ("Show All"). When unpaged, the header-checkbox toggle in
    // boolToggleHeaderCol affects every row in the data source, since
    // getVisibleRows() then returns the full set.
    var SHOW_ALL_PAGE_SIZE = 100000;
    function attachShowAllButton(prepareEvent) {
        prepareEvent.toolbarOptions.items.unshift({
            location: 'after',
            widget: 'dxButton',
            options: {
                text: 'Show All',
                hint: 'Disable pagination so header checkboxes affect every row',
                onClick: function (btnEvent) {
                    var grid = prepareEvent.component;
                    var size = grid.option('paging.pageSize');
                    var showingAll = !size || size >= SHOW_ALL_PAGE_SIZE;
                    if (showingAll) {
                        grid.option('paging.pageSize', 20);
                        btnEvent.component.option('text', 'Show All');
                    } else {
                        grid.option('paging.pageSize', SHOW_ALL_PAGE_SIZE);
                        btnEvent.component.option('text', 'Paginate');
                    }
                }
            }
        });
    }

    // Replaces the bare + icon with a labelled "Add <noun>" button.
    function labelAddButton(e, noun) {
        e.toolbarOptions.items.forEach(function (item) {
            if (item.name !== 'addRowButton') return;
            item.showText = 'always';
            item.options = $.extend({}, item.options, { text: 'Add ' + noun });
        });
    }

    // Toolbar for an Edit Tables grid: Show All plus "Add <noun>". Grids
    // save each change as it is made, so there is no Save / Undo pair.
    function toolbarWithAdd(noun) {
        return function (e) {
            attachShowAllButton(e);
            labelAddButton(e, noun);
        };
    }

    // Edit Tables grids save each change as it is made: a cell edit when it
    // loses focus, a new row once its required fields are filled, a delete
    // once confirmed. Nothing waits on a Save button that is easy to miss.
    function autoSaveEditing(canAdd, canDelete) {
        return {
            mode: 'cell',
            allowAdding: canAdd,
            allowUpdating: true,
            allowDeleting: canDelete,
            useIcons: false
        };
    }

    // Cell mode saves an edited cell as soon as it closes, but holds a new
    // row back until focus leaves the row — so a new truck sat unsaved while
    // the operator tabbed on through Description and Notes. Save a new row
    // the moment every required column has a value.
    function saveNewRowsWhenComplete(e) {
        if (e.fullName.indexOf('editing.changes') !== 0) return;
        var grid = e.component;
        setTimeout(function () {
            var required = (grid.option('columns') || []).filter(function (c) {
                return (c.validationRules || []).some(function (r) { return r.type === 'required'; });
            }).map(function (c) { return c.dataField; });
            var ready = (grid.option('editing.changes') || []).some(function (c) {
                return c.type === 'insert' && required.every(function (f) {
                    var v = c.data && c.data[f];
                    return v != null && String(v).trim() !== '';
                });
            });
            if (ready) grid.saveEditData();
        });
    }

    // A grid remembers its layout — column widths, order, visibility, sort
    // and page size — but never its filters. A filter left typed in a filter
    // box came back on every visit and made the grid look empty, with no
    // hint why. Stripping on load too clears filters browsers already saved.
    function stripFilters(state) {
        if (!state) return state;
        delete state.filterValue;
        delete state.searchText;
        delete state.filterPanel;
        (state.columns || []).forEach(function (c) {
            delete c.filterValue;
            delete c.filterValues;
            delete c.filterType;
            delete c.selectedFilterOperation;
        });
        return state;
    }
    function layoutStateStoring(storageKey) {
        return {
            enabled: true,
            type: 'custom',
            customLoad: function () {
                try { return stripFilters(JSON.parse(localStorage.getItem(storageKey))); }
                catch (e) { return null; }
            },
            customSave: function (state) {
                try { localStorage.setItem(storageKey, JSON.stringify(stripFilters(JSON.parse(JSON.stringify(state))))); }
                catch (e) { }
            }
        };
    }

    /// Boolean column with a header checkbox that toggles every visible row
    /// and saves them in one go, as a single checkbox click does. minWidth
    /// keeps the column from shrinking below 200px even when stateStoring
    /// restores a smaller manual width from a previous session.
    /// `endpoint` is currently unused (kept for forward compatibility with
    /// the /api/masterdata/{table}/bulk-set server endpoint).
    function boolToggleHeaderCol(dataField, caption, endpoint, width) {
        var col = {
            dataField: dataField,
            caption: caption,
            dataType: 'boolean',
            width: width || 200,
            minWidth: 200,
            headerCellTemplate: function (container, options) {
                var $wrap = $('<div>').css({
                    display: 'flex',
                    'align-items': 'center',
                    'justify-content': 'center',
                    gap: '8px',
                    'white-space': 'nowrap'
                });
                $('<span>').text(caption).appendTo($wrap);
                $('<input type="checkbox" class="form-check-input">')
                    .attr('title', 'Toggle every row')
                    .css({ cursor: 'pointer', margin: 0 })
                    .on('click', function (e) {
                        e.stopPropagation();
                        var checked = this.checked;
                        var grid = options.component;
                        var rows = grid.getVisibleRows();
                        rows.forEach(function (r) {
                            if (r.rowType !== 'data') return;
                            // Kiosk-header toggle: only flip rows where Active
                            // is true when turning ON, so the invariant
                            // (kiosk implies active) holds. Turning OFF is
                            // always safe.
                            if (dataField === 'useAtKiosk' && checked
                                && r.data && !r.data.active) {
                                return;
                            }
                            grid.cellValue(r.rowIndex, dataField, checked);
                        });
                        grid.saveEditData();
                    })
                    .appendTo($wrap);
                $wrap.appendTo(container);
            }
        };

        // Invariant: kiosk implies active. When Active is unchecked on a row,
        // clear UseAtKiosk on the same row so the staged edit matches the
        // server-side rule applied in UpdateCustomer/UpdateCarrier/etc.
        if (dataField === 'active') {
            col.setCellValue = function (newData, value, currentRowData) {
                newData.active = value;
                if (!value) newData.useAtKiosk = false;
            };
        }
        return col;
    }

    // Disable the kiosk cell editor on rows where Active is false. Combined
    // with the Active column's setCellValue cascade, this enforces the
    // "kiosk implies active" invariant in the UI before the operator saves.
    function disableKioskOnInactiveRow(e) {
        if (e.dataField === 'useAtKiosk' && e.parentType === 'dataRow') {
            var rowData = e.row && e.row.data;
            if (rowData && rowData.active === false) {
                e.editorOptions.disabled = true;
                e.editorOptions.value = false;
            }
        }
    }

    $(function () {
        // Deep-link support: /MasterData?tab=binsTab opens that tab directly
        // (used by the Setup page's Bins / Manage buttons). Falls back to the
        // first tab when the requested one doesn't exist (e.g. hidden field).
        (function () {
            var tab = new URLSearchParams(window.location.search).get('tab');
            if (!tab || !/^[A-Za-z0-9_-]+$/.test(tab)) return;
            var btn = document.querySelector('[data-bs-target="#' + tab + '"]');
            if (btn) new bootstrap.Tab(btn).show();
        })();

        var showKiosk = @(showKiosk ? "true" : "false");
        var useQuickBooks = @(useQuickBooks ? "true" : "false");
        var useRetainedTare = @(useRetainedTare ? "true" : "false");

        function createIdStore(endpoint) {
            return new DevExpress.data.CustomStore({
                key: 'id',
                load: function () {
                    return $.getJSON('/api/masterdata/' + endpoint);
                },
                insert: function (values) {
                    return $.ajax({
                        url: '/api/masterdata/' + endpoint,
                        method: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(values)
                    });
                },
                update: function (key, values) {
                    values.id = key;
                    return $.ajax({
                        url: '/api/masterdata/' + endpoint,
                        method: 'PUT',
                        contentType: 'application/json',
                        data: JSON.stringify(values)
                    }).catch(function (xhr) {
                        // Surface the server's rule message (e.g. "bin still
                        // has Corn on hand") instead of a generic failure.
                        var msg = (xhr.responseJSON && xhr.responseJSON.message) || 'Save failed.';
                        return $.Deferred().reject(msg);
                    });
                },
                remove: function (key) {
                    return $.ajax({
                        url: '/api/masterdata/' + endpoint + '/' + key,
                        method: 'DELETE'
                    });
                }
            });
        }

        function initNameActiveGrid(selector, endpoint, nameField, nameCaption, qbManaged, addCarrierAction, siteLookup, extraCols) {
            if (!$(selector).length) return; // tab hidden with its field (Setup → Fields)
            var lockName = useQuickBooks && qbManaged;
            var cols = [
                { dataField: 'id', caption: 'ID', width: 60, allowEditing: false },
                { dataField: nameField, caption: nameCaption, sortOrder: 'asc', allowEditing: !lockName, validationRules: lockName ? [] : [{ type: 'required' }] },
                boolToggleHeaderCol('active', 'Active', endpoint, 200)
            ];
            if (showKiosk) {
                cols.push(boolToggleHeaderCol('useAtKiosk', 'Use At Kiosk', endpoint, 200));
            }
            // Optional per-location availability (bins/commodities): blank =
            // offered at every location.
            if (siteLookup && siteLookup.length) {
                cols.push({
                    dataField: 'siteId',
                    caption: 'Location',
                    width: 180,
                    lookup: {
                        dataSource: [{ id: null, name: '— All locations —' }].concat(siteLookup),
                        valueExpr: 'id',
                        displayExpr: 'name',
                        allowClearing: true
                    }
                });
            }
            if (extraCols && extraCols.length) {
                cols = cols.concat(extraCols);
            }
            if (addCarrierAction) {
                cols.push({
                    caption: 'Carrier',
                    width: 160,
                    allowEditing: false,
                    cellTemplate: function (container, options) {
                        var data = options.data || {};
                        if (data.isCarrier) {
                            // Same outline-button shape AND width as Add to
                            // Carriers so the column reads cleanly.
                            $('<button type="button" class="btn btn-sm btn-outline-secondary btn-carrier-cell" disabled>Carrier</button>')
                                .appendTo(container);
                        } else if (data.id) {
                            $('<button type="button" class="btn btn-sm btn-outline-primary btn-carrier-cell">Add to Carriers</button>')
                                .on('click', function () {
                                    var $btn = $(this).prop('disabled', true).text('Adding…');
                                    $.ajax({
                                        url: '/api/masterdata/customers/' + data.id + '/promote-to-carrier',
                                        method: 'POST'
                                    }).done(function () {
                                        $(selector).dxDataGrid('instance').refresh();
                                        var carriersGrid = $('#carriersGrid').dxDataGrid('instance');
                                        if (carriersGrid) carriersGrid.refresh();
                                    }).fail(function () {
                                        $btn.prop('disabled', false).text('Add to Carriers');
                                    });
                                })
                                .appendTo(container);
                        }
                    }
                });
            }

            $(selector).dxDataGrid({
                hoverStateEnabled: true,
                dataSource: createIdStore(endpoint),
                showBorders: true,
                filterRow: { visible: true },
                headerFilter: { visible: true },
                allowColumnReordering: true,
                allowColumnResizing: true,
                columnChooser: { enabled: true, mode: 'select' },
                // v2 suffix — abandons pre-v1.3.44 saved column widths so
                // the new 200px Active/Kiosk defaults take effect. Future
                // manual resizes are saved under this key as before.
                stateStoring: layoutStateStoring('masterData_v2_' + endpoint),
                editing: autoSaveEditing(!lockName, !lockName),
                onToolbarPreparing: toolbarWithAdd(nameCaption.replace(/ Name$/, '')),
                onOptionChanged: saveNewRowsWhenComplete,
                onEditorPreparing: disableKioskOnInactiveRow,
                columns: cols
            });
        }

        initNameActiveGrid('#customersGrid', 'customers', 'customerName', 'Customer Name', true, true);
        initNameActiveGrid('#locationsGrid', 'locations', 'locationName', 'Location Name', false);
        initNameActiveGrid('#destinationsGrid', 'destinations', 'destinationName', 'Destination Name', false);

        // Reporting unit per commodity: reports show quantities in this unit
        // alongside pounds (corn Bushels at 56 lbs, wheat Bushels at 60, CWT at 100).
        var commodityUnitCols = [
            { dataField: 'unitName', caption: 'Reporting Unit', width: 130,
              validationRules: [{ type: 'stringLength', max: 20 }] },
            { dataField: 'unitPounds', caption: 'Lbs per Unit', dataType: 'number', width: 120,
              validationRules: [{ type: 'range', min: 0, message: 'Lbs per unit must be positive' }] }
        ];

        // Bins and commodities can be limited to a physical location (Scales
        // page → Locations); the column only appears once locations exist.
        // Bins also get an assigned-commodity column — the server rejects a
        // change while the bin still holds something else.
        var binExtraCols = [];
        $.getJSON('/api/masterdata/commodities').done(function (data) {
            var names = (data || []).filter(function (c) { return c.active; })
                .map(function (c) { return c.commodityName; });
            binExtraCols.push({
                dataField: 'commodity', caption: 'Commodity', width: 160,
                lookup: { dataSource: names, allowClearing: true }
            });
        }).always(function () {
            $.getJSON('/api/sites').done(function (data) {
                var siteLookup = (data || []).filter(function (s) { return s.active; })
                    .map(function (s) { return { id: s.id, name: s.name }; });
                initNameActiveGrid('#binsGrid', 'bins', 'binName', 'Bin Name', false, false, siteLookup, binExtraCols);
                initNameActiveGrid('#commoditiesGrid', 'commodities', 'commodityName', 'Commodity Name', true, false, siteLookup, commodityUnitCols);
            }).fail(function () {
                initNameActiveGrid('#binsGrid', 'bins', 'binName', 'Bin Name', false, false, null, binExtraCols);
                initNameActiveGrid('#commoditiesGrid', 'commodities', 'commodityName', 'Commodity Name', true, false, null, commodityUnitCols);
            });
        });

        // Dropdown-value grids for list-backed custom fields (one tab each).
        // The choices are a small ordered list, so edits save immediately
        // (cell mode) and drag-reorder PUTs the full list.
        $('.cf-list-grid').each(function () {
            var fieldId = $(this).data('field-id');
            var apiBase = '/api/customfields/' + fieldId + '/values';

            function editValue(oldValue, newValue) {
                return $.ajax({
                    url: apiBase,
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ oldValue: oldValue, newValue: newValue })
                });
            }

            $(this).dxDataGrid({
                hoverStateEnabled: true,
                showBorders: true,
                dataSource: new DevExpress.data.CustomStore({
                    key: 'value',
                    load: function () { return $.getJSON(apiBase); },
                    insert: function (values) { return editValue(null, values.value); },
                    update: function (key, values) { return editValue(key, values.value); },
                    remove: function (key) { return editValue(key, null); }
                }),
                editing: {
                    mode: 'cell',
                    allowAdding: true,
                    allowUpdating: true,
                    allowDeleting: true,
                    useIcons: false
                },
                rowDragging: {
                    allowReordering: true,
                    onReorder: function (e) {
                        var grid = e.component;
                        var values = grid.getVisibleRows().map(function (r) { return r.data.value; });
                        values.splice(e.fromIndex, 1);
                        values.splice(e.toIndex, 0, e.itemData.value);
                        $.ajax({
                            url: apiBase,
                            method: 'PUT',
                            contentType: 'application/json',
                            data: JSON.stringify(values)
                        }).done(function () { grid.refresh(); });
                    }
                },
                sorting: { mode: 'none' }, // list order = dropdown order
                columns: [{
                    dataField: 'value',
                    caption: 'Value',
                    validationRules: [{ type: 'required' }, { type: 'stringLength', max: 200 }]
                }]
            });
        });

        // Sub-field tabs (CustomField.ParentField set): a parent-value picker
        // plus the same choice grid, scoped per parent value via ?parent= on
        // the /api/customfields/{id}/values endpoints.
        var STD_PARENT_SOURCES = {
            'Commodity':   { url: '/api/masterdata/commodities',  name: 'commodityName' },
            'Customer':    { url: '/api/masterdata/customers',    name: 'customerName' },
            'Carrier':     { url: '/api/masterdata/carriers',     name: 'carrierName' },
            'Location':    { url: '/api/masterdata/locations',    name: 'locationName' },
            'Destination': { url: '/api/masterdata/destinations', name: 'destinationName' },
            'Bin':         { url: '/api/masterdata/bins',         name: 'binName' }
        };

        $('.cf-dep-list-grid').each(function () {
            var $gridEl = $(this);
            var fieldId = $gridEl.data('field-id');
            var parentField = String($gridEl.data('parent-field'));
            var apiBase = '/api/customfields/' + fieldId + '/values';
            var currentParent = null;
            var gridInited = false;

            function loadParentValues() {
                var src = STD_PARENT_SOURCES[parentField];
                if (src) {
                    return $.getJSON(src.url).then(function (rows) {
                        return rows.filter(function (r) { return r.active !== false; })
                                   .map(function (r) { return r[src.name]; });
                    });
                }
                // Parent is another custom field — its flat value union.
                var pid = parseInt(parentField.substring(3));
                return $.getJSON('/api/customfields/' + pid + '/values').then(function (rows) {
                    return rows.map(function (r) { return r.value; });
                });
            }

            function withParent(url) {
                return url + '?parent=' + encodeURIComponent(currentParent || '');
            }

            function editValue(oldValue, newValue) {
                return $.ajax({
                    url: withParent(apiBase),
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ oldValue: oldValue, newValue: newValue })
                });
            }

            function initGrid() {
                gridInited = true;
                $gridEl.dxDataGrid({
                    hoverStateEnabled: true,
                    showBorders: true,
                    dataSource: new DevExpress.data.CustomStore({
                        key: 'value',
                        load: function () { return $.getJSON(withParent(apiBase)); },
                        insert: function (values) { return editValue(null, values.value); },
                        update: function (key, values) { return editValue(key, values.value); },
                        remove: function (key) { return editValue(key, null); }
                    }),
                    editing: {
                        mode: 'cell',
                        allowAdding: true,
                        allowUpdating: true,
                        allowDeleting: true,
                        useIcons: false
                    },
                    rowDragging: {
                        allowReordering: true,
                        onReorder: function (e) {
                            var grid = e.component;
                            var values = grid.getVisibleRows().map(function (r) { return r.data.value; });
                            values.splice(e.fromIndex, 1);
                            values.splice(e.toIndex, 0, e.itemData.value);
                            $.ajax({
                                url: withParent(apiBase),
                                method: 'PUT',
                                contentType: 'application/json',
                                data: JSON.stringify(values)
                            }).done(function () { grid.refresh(); });
                        }
                    },
                    sorting: { mode: 'none' }, // list order = dropdown order
                    columns: [{
                        dataField: 'value',
                        caption: 'Value',
                        validationRules: [{ type: 'required' }, { type: 'stringLength', max: 200 }]
                    }]
                });
            }

            var picker = $('#cfParentPicker_' + fieldId).dxSelectBox({
                items: [],
                placeholder: 'Select...',
                searchEnabled: true,
                onValueChanged: function (e) {
                    currentParent = e.value;
                    if (!currentParent) {
                        $gridEl.hide();
                        $('#cfDepPickHint_' + fieldId).show();
                        return;
                    }
                    $gridEl.show();
                    $('#cfDepPickHint_' + fieldId).hide();
                    if (!gridInited) initGrid();
                    else $gridEl.dxDataGrid('instance').refresh();
                }
            }).dxSelectBox('instance');

            loadParentValues().then(function (items) {
                picker.option('items', items);
            });
        });

        // Carriers grid with trucks sub-grid (master-detail)
        var customerSuggestions = [];
        $.getJSON('/api/masterdata/customers-not-carriers').done(function (data) {
            customerSuggestions = data;
        });

        // Carrier dropdown for the Trucks tab. The list is fetched each time
        // the editor opens, so a carrier added a moment ago — on the Carriers
        // tab or with Customers → Add to Carriers — is always offered.
        // The grid builds this editor itself: a dropdown built in an
        // editCellTemplate lost its pick in cell mode, leaving the new row
        // with no carrier.
        function pickCarrierEditor(e) {
            if (e.parentType !== 'dataRow' || e.dataField !== 'carrierName') return;
            e.editorName = 'dxSelectBox';
            e.editorOptions.dataSource = {
                store: new DevExpress.data.CustomStore({
                    loadMode: 'raw',
                    load: function () {
                        return $.getJSON('/api/masterdata/carriers').then(function (rows) {
                            return rows.map(function (r) { return r.carrierName; });
                        });
                    }
                }),
                paginate: false
            };
            e.editorOptions.searchEnabled = true;
            e.editorOptions.placeholder = 'Select carrier…';
        }

        // Truck columns, shared by the Trucks tab and each carrier's
        // expandable truck list. withCarrier adds the Carrier column for the
        // Trucks tab; a carrier's own list already knows whose trucks they are.
        function truckColumns(withCarrier) {
            var cols = [{ dataField: 'id', caption: 'ID', width: 60, allowEditing: false }];
            if (withCarrier) {
                cols.push({
                    dataField: 'carrierName',
                    caption: 'Carrier',
                    sortOrder: 'asc',
                    sortIndex: 0,
                    validationRules: [{ type: 'required' }]
                    // Editor: pickCarrierEditor, from the grid's onEditorPreparing.
                });
            }
            cols.push(
                { dataField: 'truckId', caption: 'Truck ID', sortOrder: 'asc', sortIndex: withCarrier ? 1 : 0, validationRules: [{ type: 'required' }] },
                { dataField: 'description', caption: 'Description' },
                { dataField: 'notes', caption: 'Notes' }
            );
            if (showKiosk) {
                cols.push({ dataField: 'useAtKiosk', caption: 'Use At Kiosk', dataType: 'boolean', width: 130 });
            }
            if (useRetainedTare) {
                cols.push({
                    dataField: 'retainedTare',
                    caption: 'Retained Tare (lb)',
                    dataType: 'number',
                    format: { type: 'fixedPoint', precision: 0 },
                    width: 150,
                    // Editable inline. Type a value or clear the cell to
                    // wipe the stored tare. Server stamps the
                    // retainedTareUpdated column on save.
                    editorOptions: { min: 0, step: 1 }
                });
                cols.push({
                    dataField: 'retainedTareUpdated',
                    caption: 'Tare Updated',
                    dataType: 'datetime',
                    format: 'MM/dd/yyyy hh:mm a',
                    width: 160,
                    allowEditing: false
                });
                cols.push({
                    type: 'buttons',
                    name: 'clearTare',
                    width: 110,
                    buttons: [{
                        hint: 'Clear retained tare — the next weigh-in runs a normal two-pass cycle',
                        text: 'Clear Tare',
                        cssClass: 'btn-clear-tare',
                        // Always visible so the column header is consistent;
                        // disabled when there's nothing to clear.
                        disabled: function (e) {
                            return !e.row || !e.row.data || e.row.data.retainedTare == null;
                        },
                        onClick: function (e) {
                            var rowData = e.row && e.row.data;
                            if (!rowData || rowData.retainedTare == null) return;
                            promptClearTare(rowData, e.component);
                        }
                    }]
                });
            }
            // A type:'buttons' column replaces the grid's built-in command
            // column, so Delete has to be listed here or the Clear column
            // above hides it. Two buttons columns need distinct names.
            cols.push({ type: 'buttons', name: 'rowActions', width: 110, buttons: ['delete'] });
            return cols;
        }

        var carrierCols = [
            { dataField: 'id', caption: 'ID', width: 60, allowEditing: false },
            { dataField: 'carrierName', caption: 'Carrier Name', sortOrder: 'asc', validationRules: [{ type: 'required' }] },
            {
                dataField: 'truckCount',
                caption: '# Trucks',
                dataType: 'number',
                width: 110,
                allowEditing: false,
                alignment: 'center',
                cellTemplate: function (container, options) {
                    var n = options.value || 0;
                    if (!options.data || !options.data.id) { container.text(n); return; }
                    // The count opens the carrier's truck list — the expand
                    // arrow at the row's left edge is easy to miss.
                    $('<button type="button" class="btn btn-link btn-sm p-0">')
                        .text(n + (n === 1 ? ' truck' : ' trucks'))
                        .css(n === 0 ? { color: 'inherit' } : {})
                        .on('click', function (e) {
                            e.stopPropagation();
                            var grid = options.component;
                            if (grid.isRowExpanded(options.key)) grid.collapseRow(options.key);
                            else grid.expandRow(options.key);
                        })
                        .appendTo(container);
                    if (n === 0) {
                        // Pink the whole cell so zero-truck carriers stand out
                        // — those carriers can't pass the kiosk no-trucks check.
                        container.css({ background: '#ffd1dc', color: '#8a0033', 'font-weight': '600' });
                    }
                }
            },
            boolToggleHeaderCol('active', 'Active', 'carriers', 200)
        ];
        if (showKiosk) {
            carrierCols.push(boolToggleHeaderCol('useAtKiosk', 'Use At Kiosk', 'carriers', 200));
        }

        var carrierStore = createIdStore('carriers');

        if ($('#carriersGrid').length)
        $('#carriersGrid').dxDataGrid({
            hoverStateEnabled: true,
            dataSource: carrierStore,
            showBorders: true,
            filterRow: { visible: true },
            headerFilter: { visible: true },
            allowColumnReordering: true,
            allowColumnResizing: true,
            columnChooser: { enabled: true, mode: 'select' },
            stateStoring: layoutStateStoring('masterData_v3_carriers'),
            editing: autoSaveEditing(true, true),
            onToolbarPreparing: toolbarWithAdd('Carrier'),
            onOptionChanged: saveNewRowsWhenComplete,
            onEditorPreparing: function (e) {
                disableKioskOnInactiveRow(e);
                // A new carrier's name suggests customers that are not yet
                // carriers. Grid-built for the same reason as pickCarrierEditor.
                if (e.parentType === 'dataRow' && e.dataField === 'carrierName' && e.row && e.row.isNewRow) {
                    e.editorName = 'dxAutocomplete';
                    e.editorOptions.dataSource = customerSuggestions;
                    e.editorOptions.minSearchLength = 0;
                    e.editorOptions.showDropDownButton = true;
                }
            },
            columns: carrierCols,
            onSaved: refreshTrucksGrid,
            onInitNewRow: function () {
                $.getJSON('/api/masterdata/customers-not-carriers').done(function (data) {
                    customerSuggestions = data;
                });
            },
            masterDetail: {
                enabled: true,
                template: function (container, options) {
                    var carrierData = options.data;
                    var carrierName = carrierData.carrierName;

                    var truckCols = truckColumns(false);

                    $('<div>').dxDataGrid({
                        hoverStateEnabled: true,
                        dataSource: new DevExpress.data.CustomStore({
                            key: 'id',
                            load: function () {
                                return $.getJSON('/api/masterdata/trucks/' + encodeURIComponent(carrierName));
                            },
                            insert: function (values) {
                                values.carrierName = carrierName;
                                return $.ajax({
                                    url: '/api/masterdata/trucks',
                                    method: 'POST',
                                    contentType: 'application/json',
                                    data: JSON.stringify(values)
                                }).done(refreshCarriersGrid);
                            },
                            update: function (key, values) {
                                values.id = key;
                                values.carrierName = carrierName;
                                return $.ajax({
                                    url: '/api/masterdata/trucks',
                                    method: 'PUT',
                                    contentType: 'application/json',
                                    data: JSON.stringify(values)
                                }).catch(function (xhr) {
                                    // e.g. "Farm Trucks already has a truck FT-1."
                                    var msg = (xhr.responseJSON && xhr.responseJSON.message) || 'Save failed.';
                                    return $.Deferred().reject(msg);
                                });
                            },
                            remove: function (key) {
                                return $.ajax({
                                    url: '/api/masterdata/trucks/' + key,
                                    method: 'DELETE'
                                }).done(refreshCarriersGrid);
                            }
                        }),
                        showBorders: true,
                        columnAutoWidth: true,
                        onSaved: refreshTrucksGrid,
                        editing: autoSaveEditing(true, true),
                        onToolbarPreparing: function (e) { labelAddButton(e, 'Truck'); },
                        onOptionChanged: saveNewRowsWhenComplete,
                        columns: truckCols
                    }).appendTo(container);
                }
            }
        });

        // Trucks tab: every truck in one list, so trucks can be managed
        // without expanding each carrier on the Carriers tab.
        if ($('#trucksGrid').length)
        $('#trucksGrid').dxDataGrid({
            hoverStateEnabled: true,
            dataSource: createIdStore('trucks'),
            showBorders: true,
            filterRow: { visible: true },
            headerFilter: { visible: true },
            allowColumnReordering: true,
            allowColumnResizing: true,
            columnChooser: { enabled: true, mode: 'select' },
            stateStoring: layoutStateStoring('masterData_v1_trucks'),
            editing: autoSaveEditing(true, true),
            onToolbarPreparing: toolbarWithAdd('Truck'),
            onOptionChanged: saveNewRowsWhenComplete,
            onEditorPreparing: pickCarrierEditor,
            onSaved: refreshCarriersGrid,
            columns: truckColumns(true)
        });

        // ===== Unsaved-changes guard =====
        // Grids save each change as it is made, so pending edits are rare: a
        // cell still being typed in, or a new row missing a required field.
        // When one exists and the operator follows an in-app link or switches
        // tab, a modal offers Save, Discard or Stay; closing the browser tab
        // falls back to its native beforeunload prompt.
        var mdIsLeaving = false;
        var MD_GRIDS = ['#customersGrid', '#carriersGrid', '#trucksGrid', '#locationsGrid',
                        '#destinationsGrid', '#binsGrid', '#commoditiesGrid'];
        function mdEachGrid(fn) {
            MD_GRIDS.forEach(function (sel) {
                var inst = $(sel).dxDataGrid('instance');
                if (inst) fn(inst);
            });
        }
        function mdAnyGridDirty() {
            var dirty = false;
            mdEachGrid(function (g) { if (g.hasEditData()) dirty = true; });
            return dirty;
        }
        // Resolves once every dirty grid has round-tripped. A grid can still
        // be dirty afterwards when a row failed validation — callers check.
        function mdSaveAllGrids() {
            var saves = [];
            mdEachGrid(function (g) { if (g.hasEditData()) saves.push(g.saveEditData()); });
            return $.when.apply($, saves);
        }
        function mdCancelAllGrids() {
            mdEachGrid(function (g) { g.cancelEditData(); });
        }
        // Exposed for the QB-sync confirmation flow defined in the IIFE below.
        window.mdAnyGridDirty = mdAnyGridDirty;
        window.mdSaveAllGrids = mdSaveAllGrids;
        window.mdCancelAllGrids = mdCancelAllGrids;

        $(window).on('beforeunload', function () {
            if (mdAnyGridDirty() && !mdIsLeaving) return 'You have unsaved changes.';
        });

        var mdPendingHref = null;
        var mdPendingTabBtn = null;
        var mdSuppressTabGuard = false;

        // In-app navigation (regular <a>, e.g. "Back to Setup"). Bootstrap
        // tab switches are handled separately via show.bs.tab below.
        $('a').on('click', function (e) {
            if (!mdAnyGridDirty() || mdIsLeaving) return;
            if ($(this).attr('data-bs-toggle') === 'tab') return;
            var href = $(this).attr('href');
            if (!href || href.indexOf('#') === 0) return;
            e.preventDefault();
            mdPendingHref = href;
            mdPendingTabBtn = null;
            new bootstrap.Modal('#mdLeaveConfirmModal').show();
        });

        // Tab switching inside the page also prompts when there are pending
        // edits — otherwise the operator could shuttle between tabs and
        // forget the staged work.
        $('[data-bs-toggle="tab"]').on('show.bs.tab', function (e) {
            if (mdSuppressTabGuard) return;
            if (!mdAnyGridDirty()) return;
            e.preventDefault();
            mdPendingTabBtn = e.target;
            mdPendingHref = null;
            new bootstrap.Modal('#mdLeaveConfirmModal').show();
        });

        function mdHideLeaveModal() {
            bootstrap.Modal.getInstance(document.getElementById('mdLeaveConfirmModal')).hide();
        }

        $('#mdLeaveDiscardBtn').on('click', function () {
            mdHideLeaveModal();
            mdCancelAllGrids();
            mdProceed();
        });

        $('#mdLeaveSaveBtn').on('click', function () {
            var $btn = $(this).prop('disabled', true).text('Saving…');
            mdSaveAllGrids().always(function () {
                $btn.prop('disabled', false).text('Save & Continue');
                mdHideLeaveModal();
                // A row that failed validation stays dirty and shows its error
                // in the grid — stay so the operator can fix it.
                if (!mdAnyGridDirty()) mdProceed();
            });
        });

        // Carry on with whatever the modal interrupted: a tab switch or a link.
        function mdProceed() {
            if (mdPendingTabBtn) {
                // Tab switch: tell the show.bs.tab handler to skip its guard
                // for this one programmatic call so we don't loop.
                var btn = mdPendingTabBtn;
                mdPendingTabBtn = null;
                mdSuppressTabGuard = true;
                try { new bootstrap.Tab(btn).show(); }
                finally { mdSuppressTabGuard = false; }
                return;
            }
            if (mdPendingHref) {
                mdIsLeaving = true; // suppresses beforeunload on the upcoming nav
                window.location.href = mdPendingHref;
            }
        }
    });
</script>
<script src="~/js/signalr/signalr.min.js"></script>
<script>
    // --- QuickBooks Sync via SignalR (loaded after signalr.min.js) ---
    (function () {
        var syncConnection = new signalR.HubConnectionBuilder()
            .withUrl("/scaleHub")
            .withAutomaticReconnect()
            .build();

        syncConnection.on("QBSyncStatus", function (message) {
            $('#qbSyncStatus').text(message);
        });

        syncConnection.on("QBSyncComplete", function (summary) {
            $('#qbSyncStatus').text(summary);
            $('#btnQBSync').prop('disabled', false).html('<i class="fa fa-download"></i> Sync from QuickBooks');
            var grids = ['#customersGrid', '#carriersGrid', '#locationsGrid', '#destinationsGrid', '#commoditiesGrid'];
            grids.forEach(function (sel) {
                var instance = $(sel).dxDataGrid('instance');
                if (instance) instance.refresh();
            });
        });

        syncConnection.on("QBNotRunning", function (message) {
            $('#qbSyncStatus').text('');
            $('#btnQBSync').prop('disabled', false).html('<i class="fa fa-download"></i> Sync from QuickBooks');
            var html = '<div class="alert alert-danger alert-dismissible fade show" role="alert">' +
                '<i class="fa fa-exclamation-triangle"></i> ' + message +
                '<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>';
            if (!$('#qb-alert-container').length) $('body').prepend('<div id="qb-alert-container" style="position:fixed;top:10px;right:10px;z-index:9999;max-width:500px;"></div>');
            $('#qb-alert-container').html(html);
        });

        function updateQBBanner(connected) {
            var banner = document.getElementById('qbStatusBanner');
            var btn = document.getElementById('btnQBSync');
            if (banner) {
                if (connected) {
                    banner.style.cssText = 'background-color:#d1e7dd !important;border-color:#badbcc !important;color:#0f5132 !important;padding:6px 16px !important;margin-bottom:8px !important;border-radius:6px !important;display:flex !important;align-items:center !important;';
                    banner.innerHTML = '<div><i class="fa fa-check-circle"></i> <strong>QuickBooks Connected</strong> — Customer and Commodity names are managed by QuickBooks. Use the <strong>Sync from QuickBooks</strong> button to update.</div>';
                } else {
                    banner.style.cssText = 'background-color:#f8d7da !important;border-color:#f5c2c7 !important;color:#842029 !important;padding:6px 16px !important;margin-bottom:8px !important;border-radius:6px !important;display:flex !important;align-items:center !important;';
                    banner.innerHTML = '<div><i class="fa fa-times-circle"></i> <strong>QuickBooks Not Connected</strong> — Please start the QBSyncService and try again.</div>';
                }
            }
            if (btn) btn.style.display = connected ? '' : 'none';
        }

        syncConnection.on("QBServiceStatusChanged", function (connected) {
            updateQBBanner(connected);
        });

        syncConnection.start().then(function () {
            return syncConnection.invoke("CheckQBServiceConnected");
        }).then(function (connected) {
            updateQBBanner(connected);
        }).catch(function (err) {
            console.error("SignalR connect error:", err);
            updateQBBanner(false);
        });

        // Actual sync invocation, called either directly (no pending edits)
        // or after the operator confirms discarding staged edits in the modal.
        function doQBSync() {
            syncConnection.invoke("CheckQBServiceConnected").then(function (connected) {
                if (!connected) {
                    var html = '<div class="alert alert-danger alert-dismissible fade show" role="alert">' +
                        '<i class="fa fa-exclamation-triangle"></i> QuickBooks Sync Service is not connected. Please start the QBSyncService and try again.' +
                        '<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>';
                    if (!$('#qb-alert-container').length) $('body').prepend('<div id="qb-alert-container" style="position:fixed;top:10px;right:10px;z-index:9999;max-width:500px;"></div>');
                    $('#qb-alert-container').html(html);
                    return;
                }
                $('#btnQBSync').prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Syncing...');
                $('#qbSyncStatus').text('Requesting sync...');
                syncConnection.invoke("TriggerQBSync").catch(function (err) {
                    $('#qbSyncStatus').text('Error: ' + err);
                    $('#btnQBSync').prop('disabled', false).html('<i class="fa fa-download"></i> Sync from QuickBooks');
                });
            }).catch(function (err) {
                $('#qbSyncStatus').text('Error checking service: ' + err);
            });
        }

        window.triggerQBSync = function () {
            // Sync refreshes every grid on completion, which silently drops
            // any unsaved edit. Warn first so the operator can save before
            // continuing.
            if (typeof window.mdAnyGridDirty === 'function' && window.mdAnyGridDirty()) {
                new bootstrap.Modal('#mdSyncConfirmModal').show();
                return;
            }
            doQBSync();
        };

        $(function () {
            $('#mdSyncDiscardBtn').on('click', function () {
                bootstrap.Modal.getInstance(document.getElementById('mdSyncConfirmModal')).hide();
                // Cancel pending edits so the upcoming refresh doesn't race them.
                window.mdCancelAllGrids();
                doQBSync();
            });

            // Save pending edits across every grid, then sync. A row that
            // failed validation leaves its grid dirty — stay so the operator
            // can fix the inline error.
            $('#mdSyncSaveBtn').on('click', function () {
                var $btn = $(this).prop('disabled', true).text('Saving…');
                window.mdSaveAllGrids().then(function () {
                    $btn.prop('disabled', false).text('Save & Sync');
                    if (window.mdAnyGridDirty()) return;
                    bootstrap.Modal.getInstance(document.getElementById('mdSyncConfirmModal')).hide();
                    doQBSync();
                }, function () {
                    $btn.prop('disabled', false).text('Save & Sync');
                });
            });
        });
    })();
</script>
}
