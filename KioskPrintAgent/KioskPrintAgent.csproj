<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      Fallback for local builds. The release workflow passes -p:Version from the
      git tag, so a published artifact reports the release it shipped in. Left
      unset it would default to 1.0.0 forever, which is what every agent in the
      field reported before this.
    -->
    <Version>1.26.1</Version>
    <Product>Kiosk Print Agent</Product>
    <Description>Remote print agent for Foundation kiosk. Receives SignalR print requests and prints tickets via CUPS on Linux.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.*" />
  </ItemGroup>

</Project>
